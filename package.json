{
  "name": "@theodi/data-standard-validator",
  "version": "1.0.0",
  "description": "Validate JSON and JSON-LD documents against SHACL shapes, with plain-English errors that point at the JSON path and line.",
  "license": "MIT",
  "author": "The Open Data Institute",
  "homepage": "https://theodi.github.io/data-standard-validator/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/theodi/data-standard-validator.git"
  },
  "bugs": "https://github.com/theodi/data-standard-validator/issues",
  "keywords": [
    "shacl",
    "json-ld",
    "validation",
    "rdf",
    "data-standards",
    "linked-data",
    "cli"
  ],
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "data-standard-validator": "dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "node": "./dist/node.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json && chmod +x dist/cli.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "prepare": "npm run build"
  },
  "dependencies": {
    "@rdfjs/types": "^2.0.1",
    "commander": "^14.0.3",
    "jsonc-parser": "^3.3.1",
    "jsonld": "^9.0.0",
    "n3": "^2.13.12",
    "picocolors": "^1.1.1",
    "rdf-ext": "^2.6.0",
    "rdf-validate-shacl": "^0.6.5"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "typescript": "^6.0.3",
    "vitest": "^4.1.12"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
